# Copy this file to .env and fill in real values. Never commit the .env file.

# --- Application ---
APP_NAME=skinai-ai-service
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (consumed directly by the `db` service in compose.yaml) ---
POSTGRES_USER=skinai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=skinai
POSTGRES_TEST_DB=skinai_test

# --- App database connection ---
# docker compose overrides this automatically to point at the `db` service
# (see compose.yaml). Set it explicitly only when running the app outside
# of docker compose, e.g. against a local Postgres install.
DATABASE_URL=postgresql+asyncpg://skinai:changeme@localhost:5432/skinai

# --- Embeddings ---
# Dimensionality of stored embedding vectors. 1536 matches OpenAI's
# text-embedding-3-small. No embedding provider is implemented yet
# (app/services/embedding.py) -- this only sizes the pgvector columns.
# Changing it after data exists requires a new Alembic migration.
EMBEDDING_DIMENSION=1536

# --- CORS ---
# JSON array of allowed origins, e.g. ["http://localhost:3000"]. Empty by
# default: no CORS middleware is installed until you set this.
CORS_ORIGINS=[]
